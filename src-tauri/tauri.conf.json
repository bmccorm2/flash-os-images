{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FlashOS",
  "version": "0.1.0",
  "identifier": "com.bryan.flashos",
  "build": {
    "beforeDevCommand": "bun run dev:app",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "FlashOS",
        "width": 960,
        "height": 560,
        "minWidth": 680,
        "minHeight": 480,
        "resizable": true,
        "theme": "Dark",
        "backgroundColor": "#1f2227"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  }
}
